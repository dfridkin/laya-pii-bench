{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "USE_TF": "0",
    "TOKENIZERS_PARALLELISM": "false"
  },
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(uv sync)",
      "Bash(uv add *)",
      "Bash(uv lock *)",
      "Bash(make *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git rev-parse *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(shasum *)",
      "Bash(sha256sum *)",
      "Bash(npm --prefix hud *)",
      "Bash(npx --yes json-schema-to-typescript*)",
      "Bash(touch .locks/*)",
      "Bash(mkdir -p *)",
      "Edit(bench/**)",
      "Edit(tests/**)",
      "Edit(scripts/**)",
      "Edit(hud/**)",
      "Edit(finetune/**)",
      "Edit(docs/**)",
      "Edit(reports/**)",
      "Edit(fixtures/**)",
      "Edit(schema/**)",
      "WebFetch(domain:huggingface.co)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:nandhakishorm.github.io)"
    ],
    "ask": [
      "Edit(config/**)",
      "Edit(CLAUDE.md)",
      "Edit(docs/DECISIONS.md)",
      "Edit(.claude/**)",
      "Bash(uv remove *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-artifacts.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-python.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-context.sh"
          }
        ]
      }
    ]
  }
}
