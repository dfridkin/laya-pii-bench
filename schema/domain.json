        "batch_size": {
          "minimum": 1,
          "type": "integer"
        },
        "checkpoint": {
          "type": "string"
        },
        "checkpoint_rev": {
          "type": "string"
        },
        "latency_ms": {
          "type": "number"
        },
        "max_len": {
          "type": "integer"
        },
        "qs": {
          "type": "string"
        },
        "t_offset_ms": {
          "type": "number"
        },
        "unit_id": {
          "type": "string"
        },
        "warmup": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "unit_id",
        "arm",
        "qs",
        "checkpoint",
        "checkpoint_rev",
        "max_len",
        "answers",
        "latency_ms",
        "t_offset_ms",
        "batch_size"
