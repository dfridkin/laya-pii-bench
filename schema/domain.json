          "const": "calib",
          "type": "string"
        },
        "precision_target": {
          "type": "number"
        },
        "qs": {
          "type": "string"
        },
        "recall_target": {
          "type": "number"
        },
        "t_high": {
          "type": "number"
        },
        "t_low": {
          "type": "number"
