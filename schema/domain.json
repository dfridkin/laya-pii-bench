        "temperatures": {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        }
      },
      "required": [
        "arm",
        "qs",
        "temperatures",
        "t_low",
        "t_high",
        "recall_target",
        "precision_target",
        "fit_on",
        "content_hash"
