{# CIOMS I form. Context: study, site, sub, ae, reporter, report_date, followups #}
{{ section("CIOMS I: Suspect Adverse Reaction Report") }}
Manufacturer control no.: {{ neg(ctrl_no, "report_no") }}    Protocol: {{ protocol(study) }}    Site: {{ site_no(site.site_no) }}

{{ section("I. Reaction Information") }}
1. Patient initials: {{ initials(sub.person, alt="not provided") }}    1a. Subject: {{ subject_id(sub, alt="not provided") }}
2. Date of birth: {{ dob(sub, alt="withheld") }}    2a. Age: {{ age(sub) }} years    3. Sex: {{ sub.person.sex }}
